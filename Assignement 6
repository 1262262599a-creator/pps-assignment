
#include <stdio.h>

int fact_loop(int n) {
    int f = 1;
    for (int i = 1; i <= n; i++) f *= i;
    return f;
}

int fact_rec(int n) {
    if (n <= 1) return 1;
    return n * fact_rec(n - 1);
}

int main() {
    int n;
    scanf("%d", &n);
    printf("Without recursion: %d\n", fact_loop(n));
    printf("With recursion: %d\n", fact_rec(n));
    return 0;
}
